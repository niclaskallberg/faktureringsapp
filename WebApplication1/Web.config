<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!-- Define a plain text dictionary section for public mail settings -->
    <section name="mailSettingsPublic" type="System.Configuration.NameValueSectionHandler" />
  </configSections>
  <!-- Public settings live here in plain text -->
  <mailSettingsPublic>
    <add key="SmtpServer" value="" />
    <add key="SmtpPort" value="" />
  </mailSettingsPublic>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2" />
    <!-- enableVersionHeader tar bort response-headern X-AspNet-Version som exponerar den exakta framework-versionen -->
    <httpRuntime targetFramework="4.7.2" enableVersionHeader="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
